# Deny all direct web access to the operator scripts.
#
# Defence in depth, not a live fix: every script here refuses a web request on
# its own - the PHP files are PHP_SAPI guarded (dev-router.php: cli-server only)
# and config.dev.php is behind GV_BOOT. scripts/guard-selftest.php checks that
# for EVERY file in this directory and requests each one through PHP's web
# server (gen-reason-docs.php had no guard and rewrote docs/14-REASON-CODES.md). This makes scripts/ consistent with guard/ and logs/, so a
# future script that forgets its own guard is still covered.
#
# No exceptions: nothing in this directory is meant to be reachable from the web.
<IfModule mod_authz_core.c>
	Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
	Order allow,deny
	Deny from all
</IfModule>
# Second, independent mechanism: servers differ in which directive family they
# honour inside .htaccess (Apache 2.4 reads both; LiteSpeed's support for the
# authorization family varies by edition), so a rewrite rule answers 403 as well.
<IfModule mod_rewrite.c>
	RewriteEngine On
	RewriteRule ^ - [F,L]
</IfModule>
