# Bot Guard admin panel.
#
# Only index.php and the static assets are reachable. Everything else here -
# credentials, the audit trail, the rate-limit counters, the view templates and
# every library file - is denied outright.
#
# This is defence in depth, not the only defence: every PHP file under panel/
# also refuses to run unless GP_BOOT is defined, so a server that ignores
# .htaccess still exposes nothing.

<IfModule mod_authz_core.c>
	Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
	Order allow,deny
	Deny from all
</IfModule>

# The empty alternative is the directory request itself (/gv-admin/): without it
# Apache 2.4 refuses the panel's own URL with 403 before DirectoryIndex runs.
<FilesMatch "^(index\.php|recover\.php)?$">
	<IfModule mod_authz_core.c>
		Require all granted
	</IfModule>
	<IfModule !mod_authz_core.c>
		Order allow,deny
		Allow from all
	</IfModule>
</FilesMatch>

<FilesMatch "\.(css|woff2)$">
	<IfModule mod_authz_core.c>
		Require all granted
	</IfModule>
	<IfModule !mod_authz_core.c>
		Order allow,deny
		Allow from all
	</IfModule>
</FilesMatch>

# The credential file must never be served, whatever the rules above resolve to.
<FilesMatch "^(panel\.config\.php|audit\.jsonl)$">
	<IfModule mod_authz_core.c>
		Require all denied
	</IfModule>
	<IfModule !mod_authz_core.c>
		Order allow,deny
		Deny from all
	</IfModule>
</FilesMatch>

# Second, independent mechanism for servers that do not honour the authorization
# directives in .htaccess: only the entry point and the static assets may be
# served; everything else answers 403. The empty alternative is the directory
# request (/panel/), which DirectoryIndex then maps to index.php. This file lists
# the complete set on its own: a parent directory's deny-all rewrite rule is not
# applied here (verified on Apache 2.4 and OpenLiteSpeed 1.9).
#
# Apache only evaluates RewriteRule where Options FollowSymLinks or
# SymLinksIfOwnerMatch is on; with neither (for example "Options None" in an
# Alias block) every panel request would answer 403. docs/03-SETUP.md shows the
# Alias block with Options FollowSymLinks.
<IfModule mod_rewrite.c>
	RewriteEngine On
	RewriteRule ^(|index\.php|assets/[A-Za-z0-9._-]+\.(css|woff2))$ - [L]
	RewriteRule ^ - [F,L]
</IfModule>

<IfModule mod_headers.c>
	Header set X-Content-Type-Options "nosniff"
	Header set Referrer-Policy "no-referrer"
	# Also for what Apache answers itself (assets, 403s): PHP adds the same header
	# to every page it renders. "always" covers error responses too.
	Header always set X-Robots-Tag "noindex, nofollow, noarchive, nosnippet"
</IfModule>
