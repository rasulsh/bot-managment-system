logs/*.jsonl
logs/*.gz
guard.off
guard/config.local.json.lock

# Phase 2 analyzer artefacts: all derived from real traffic, never committed.
analyzer/model.joblib
analyzer/*.csv
analyzer/*.lock
analyzer/.*.lock
__pycache__/
*.pyc

# Phase 3 artefacts: derived from real traffic, never committed.
analyzer/clf.joblib
analyzer/ground-truth.txt
analyzer/reports/
# Generated HTML reports (analyzer/report.py --html) are never committed; a repo-wide *.html rule used to hide any legitimate HTML file too.
analyzer/*.html
analyzer/reports/*.html

# Phase 4 candidate model artefacts.
analyzer/model.joblib.candidate
analyzer/clf.joblib.candidate
analyzer/*.candidate

# Phase 5 panel: credentials, overlay, snapshot and audit trail stay local.
panel/panel.config.php
panel/audit.jsonl
panel/users.json
panel/users.json.*
panel/*.log
panel/.ratelimit/
guard/config.local.json
guard/config.local.json.tmp*
analyzer/snapshot.json
analyzer/snapshot.json.tmp
analyzer/.lastrun-*

# Runtime data of the panel (users.json, audit.jsonl, sign-in counters): never committed.
data/*
!data/.htaccess
!data/.gitkeep

# Runtime files the guard writes into logs/ (error log, throttle markers, circuit-breaker marker).
logs/guard-errors.log
logs/guard-errors-*.log
logs/guard-errors-*.log.gz
logs/.err-*
logs/.redis-down
logs/.last-rotate
logs/.last-rotate.tmp
logs/.panel-path
logs/.logrotate.lock
# Analyzer run statistics (next to the model).
analyzer/.laststats-*
analyzer/*.tmp

# Panel backups of the overlay (every save keeps the previous version).
guard/config-backups/

# GeoIP: databases and their compiled files are downloaded or compiled per install.
geo/*.bin
geo/*.bin.prev
geo/*.mmdb
geo/*.dat
geo/geo-status.json
geo/known.json
geo/*.tmp*
geo/*.part*
geo/*.rb*
geo/*.lock

# Access rules: written by the panel, local to each install.
guard/rules.json
guard/rules.json.tmp*
guard/rules.json.lock
analyzer/.rule-hits.json
analyzer/rowstore/
analyzer/.nightly-spool-*/
guard/logskip.cache.php*
analyzer/daily/
analyzer/.ingest-state.json*
guard/rules.cache.php
guard/rules.cache.php.tmp*

# Job status written by the cron wrappers (scripts/lib-jobstatus.sh) and the panel.
analyzer/.jobstatus-*.json
analyzer/.jobstatus-*.json.tmp*
analyzer/.jobstate-*
analyzer/.cron-check.json
analyzer/.cron-check-live.json
analyzer/.cron-check-live.json.tmp*
analyzer/.cron-check-refresh
analyzer/.cron-check.json.tmp*
analyzer/.perm-check.json
analyzer/.perm-check.json.tmp*
panel/jobs-seen.json
panel/jobs-seen.json.tmp*
logs/jobs.log
logs/jobs-errors.log
logs/jobs-*.log.gz
logs/jobs-errors-*.log.gz

# IP lists: written by the panel, local to each install.
lists/*.txt
lists/*.bin
lists/*.bin.prev
lists/lists.json
lists/lists-status.json
lists/*.tmp*
lists/*.rb*
lists/.pending-*
lists/.*.lock
lists/.compile.lock

# In-panel updater: manifests, backups, staged ZIPs, recovery scripts and the token store stay local.
updates/*
!updates/.htaccess
!updates/.gitkeep
