# Bot Guard update workspace: manifests, backups, staged files and recovery scripts.
# Nothing here is served. Recovery from the web goes through panel/recover.php,
# which needs a one-time token.
<IfModule mod_authz_core.c>
	Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
	Order allow,deny
	Deny from all
</IfModule>
<IfModule mod_rewrite.c>
	RewriteEngine On
	RewriteRule ^ - [F,L]
</IfModule>
